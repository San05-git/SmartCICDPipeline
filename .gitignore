# =============================================================================
# .gitignore — Files and directories Git should ignore
# =============================================================================

# Node.js dependencies
node_modules/

# Environment variables (never commit secrets!)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# Docker
.docker/

# Test coverage
coverage/

# Local validation store created by the demo app
data/
